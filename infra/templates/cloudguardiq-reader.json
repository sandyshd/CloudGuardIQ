{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "cloudguardiq",
      "comment": "Assigns the Reader role to the CloudGuardIQ multi-tenant app at subscription scope. Deploy once per subscription to grant CloudGuardIQ read access."
    }
  },
  "parameters": {
    "cloudGuardIQPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object id of the CloudGuardIQ service principal in the customer tenant. CloudGuardIQ surfaces this in the Settings UI after admin consent completes."
      }
    },
    "roleDefinitionId": {
      "type": "string",
      "defaultValue": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
      "metadata": {
        "description": "Built-in Reader role id. Override only if you want a more permissive role."
      }
    }
  },
  "variables": {
    "roleAssignmentName": "[guid(deployment().name, parameters('cloudGuardIQPrincipalId'), parameters('roleDefinitionId'))]",
    "roleDefinition": "[concat('/providers/Microsoft.Authorization/roleDefinitions/', parameters('roleDefinitionId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleAssignmentName')]",
      "properties": {
        "roleDefinitionId": "[variables('roleDefinition')]",
        "principalId": "[parameters('cloudGuardIQPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "roleAssignmentId": {
      "type": "string",
      "value": "[variables('roleAssignmentName')]"
    }
  }
}


