VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=common
VITE_REDIRECT_URI=http://localhost:3000
VITE_API_BASE_URL=/api

# Microsoft Entra External ID (CIAM) -- Phase 3. Lets AWS/GCP-only customers
# sign up with email or Google without an Azure tenant. Leave blank to disable
# CIAM (only the Microsoft work-account button is shown).
# e.g. https://contoso.ciamlogin.com/<ciam-tenant-guid>
VITE_CIAM_AUTHORITY=
VITE_CIAM_CLIENT_ID=
# Optional delegated API scope; defaults to <ciam-client-id>/.default
VITE_CIAM_API_SCOPE=
