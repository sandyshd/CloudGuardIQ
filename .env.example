# ---- CloudGuardIQ Environment Variables ----
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Authentication uses Azure RBAC (DefaultAzureCredential).
# No API keys or secrets needed -- managed identity or az login is used.

# Azure AD / Entra ID
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Azure Cosmos DB (serverless) -- RBAC via DefaultAzureCredential
CLOUDGUARDIQ_COSMOS_ENDPOINT=

# Azure OpenAI GPT-4o -- RBAC via DefaultAzureCredential
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=

# Azure Key Vault
KEY_VAULT_URL=
