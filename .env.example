# ---- CloudGuardIQ Environment Variables ----
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Authentication uses Azure RBAC (DefaultAzureCredential).
# No API keys or secrets needed -- managed identity or az login is used.

# Azure AD / Entra ID
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Microsoft Entra External ID (CIAM) -- Phase 2. Lets AWS/GCP-only
# customers sign up (email / Google) without an Azure tenant. Leave
# CIAM_AUTHORITY blank to keep CIAM disabled (Azure workforce only).
# AUTH_PROVIDER: entra_workforce (default) | entra_external_id
CLOUDGUARDIQ_AUTH_PROVIDER=entra_workforce
# e.g. https://contoso.ciamlogin.com/<ciam-tenant-guid>
CLOUDGUARDIQ_CIAM_AUTHORITY=
# API application (audience) the SPA requests a token for
CLOUDGUARDIQ_CIAM_CLIENT_ID=
# Optional explicit issuer override; derived as {authority}/v2.0 when blank
CLOUDGUARDIQ_CIAM_ISSUER=

# Azure Cosmos DB (serverless) -- RBAC via DefaultAzureCredential
CLOUDGUARDIQ_COSMOS_ENDPOINT=

# Azure OpenAI GPT-5.1 -- RBAC via DefaultAzureCredential
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.1

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=

# Azure Key Vault
KEY_VAULT_URL=

# ---- Phase 3: Cross-tenant SaaS onboarding ----
# Optional. When the platform serves customers in *other* Entra tenants, the
# CloudGuardIQ multi-tenant app needs a credential to authenticate against
# each customer tenant. Provide either a certificate path (preferred) OR
# a client secret -- the auth.customer_credential factory picks the
# certificate when both are set.
CLOUDGUARDIQ_AZURE_CERTIFICATE_PATH=
CLOUDGUARDIQ_AZURE_CLIENT_SECRET=

# Cosmos container holding admin-consent records for cross-tenant
# customers. Defaults to "tenant_consents".
CLOUDGUARDIQ_COSMOS_CONTAINER_TENANT_CONSENTS=tenant_consents

# Frontend redirect URI used by the admin-consent popup. Must match a
# Reply URL registered on the Azure AD app.
CLOUDGUARDIQ_CONSENT_REDIRECT_URI=http://localhost:3000/settings?consent=callback
